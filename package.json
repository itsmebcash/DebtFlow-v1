{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "assets:generate": "npx @capacitor/assets generate --android",
    "assets:clean": "node scripts/clean-assets.js",
    "assets:verify": "node scripts/verify-assets.js",
    "assets:full-rebuild": "node scripts/full-rebuild.js",
    "android:build": "cd android && call gradlew.bat assembleRelease",
    "android:build:debug": "cd android && call gradlew.bat assembleDebug",
    "android:install:debug": "cd android && call gradlew.bat installDebug",
    "android:clean": "cd android && call gradlew.bat clean",
    "android:open": "npx cap open android"
  },
  "dependencies": {
